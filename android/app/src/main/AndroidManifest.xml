<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Le retour du réseau : le relais se reconnecte aussitôt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Les notifications locales (Android 13 et plus les demande). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- L'empreinte ou le visage. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- La caméra (déclarée avec les appels plus bas) sert aussi à scanner
         un QR code : lier un appareil, ajouter un contact. -->

    <!-- Prendre une photo avec l'appareil (le profil), sans l'exiger. -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Les appels audio et vidéo (WebRTC) : le micro, la caméra, le son de
         l'appel (mode communication, haut-parleur), le vibreur de la sonnerie,
         l'appel qui arrive en plein écran même verrouillé, et le service au
         premier plan pendant l'appel (de type appel téléphonique, micro et
         caméra ; `MANAGE_OWN_CALLS` le permet sans être l'application
         Téléphone). Ni l'un ni l'autre n'est exigé de l'appareil. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <application
        android:name=".TalkaApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Talka"
        android:supportsRtl="true"
        android:theme="@style/Theme.Talka">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- talka://add/K7Q2MX9PRT, talka://chat/…, talka://chats -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="talka" />
            </intent-filter>
            <!-- Les liens d'invitation du relais : https://…/c/K7Q2MX9PRT -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${talkaHost}" android:pathPrefix="/c/" />
            </intent-filter>
        </activity>

        <!-- Les fichiers donnés à une autre application (`SharedFiles`) : la
             feuille de partage, et la photo de l'appareil photo en pleine
             taille. Rien que deux dossiers du cache (`fichiers.xml`), et
             seulement à l'application choisie. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fichiers"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/fichiers" />
        </provider>

        <!-- Les appels : le service au premier plan pendant l'appel, et les
             boutons des notifications (Refuser, Raccrocher). -->
        <service
            android:name=".call.CallService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|microphone|camera" />
        <receiver
            android:name=".call.CallActions"
            android:exported="false" />
        <!-- Les widgets de l'écran d'accueil (Jetpack Glance) : « Non lus » et
             « Discussions », ceux de l'iPhone. -->
        <receiver
            android:name=".widgets.UnreadWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_unread_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_unread" />
        </receiver>
        <receiver
            android:name=".widgets.RecentChatsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_recent_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_recent" />
        </receiver>

        <!-- La montre (Wear OS) : ce qu'elle envoie au téléphone, même Talka
             fermé (voir WearProtocol). Seulement de la montre appairée, et
             seulement si elle porte la même application, signée de la même clé. -->
        <service
            android:name=".watch.WatchService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:path="/talka/action" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/talka/queue/" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/talka/voice/" />
            </intent-filter>
        </service>
    </application>
</manifest>
