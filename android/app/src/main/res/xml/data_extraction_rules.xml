<?xml version="1.0" encoding="utf-8"?>
<!-- Rien ne part dans les sauvegardes du système : les clés et les
     messages restent sur l'appareil (Talka a sa propre sauvegarde chiffrée). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
